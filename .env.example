# Secrets and host settings only. Everything else lives in config/*.json.
# `cp .env.example .env`, fill, never commit .env. Every private key here is a Fuji-only wallet.
PANTADO_PROFILE=contest

# ---------------------------------------------------------------- host (infra/deploy-vps.sh)
# App at https://DOMAIN; api., agent. and grafana. subdomains point to the same VPS.
DOMAIN=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- RPC fallbacks
# Primary URLs are in config/networks/<profile>.json (public endpoints, rate-limited).
# A provider URL here makes market-data and the keepers sturdier.
AVAX_RPC_URL_FALLBACK=
FUJI_RPC_URL_FALLBACK=
ROBINHOOD_RPC_URL_FALLBACK=

# ---------------------------------------------------------------- Fuji wallets (six different wallets)
# Fund the deployer from a Fuji faucet; scripts/deploy-fuji.ts tops up the others.
DEPLOYER_PRIVATE_KEY=
KEEPER_PRICE_PUSHER_KEY=
KEEPER_TRIGGER_KEY=
KEEPER_FILLER_KEY=
KEEPER_AUTO_FUND_KEY=
AGENT_MANAGER_KEY=
AGENT_MANAGER_DRY_RUN=false

# Shared secret between api and the auto-fund keeper (any long random string: openssl rand -hex 32)
AUTO_FUND_SECRET=

# ---------------------------------------------------------------- stock price source
# Default: Chainlink equity feeds on Robinhood Chain (no key). "none" turns the stock cross-check off.
STOCK_API_PROVIDER=chainlink-robinhood

# ---------------------------------------------------------------- wallets and gas
# Optional. Without a Privy app id the app connects browser wallets (EIP-1193).
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional. Without a paymaster users pay gas in test AVAX (auto-funded on first sign-in).
PAYMASTER_URL=

# ---------------------------------------------------------------- agent
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_API_KEY=
AGENT_AUTO_MODEL=claude-haiku-5-5
AGENT_DEEP_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- acceptance (test/e2e-app/acceptance.ts)
# Optional second wallet for spec §14 step 5; a fresh one is generated and funded when empty.
ACCEPTANCE_USER_KEY=

# demo creators / buyers for scripts/seed-demo.ts (Fuji testnet only)
DEMO_WALLET_1=
DEMO_WALLET_2=
DEMO_WALLET_3=
DEMO_WALLET_4=
DEMO_WALLET_5=
DEMO_WALLET_6=
DEMO_WALLET_7=
DEMO_WALLET_8=
